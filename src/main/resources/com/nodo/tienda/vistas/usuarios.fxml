<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nodo.tienda.controladores.UsuariosControlador"
      prefWidth="980.0" prefHeight="700.0" spacing="12.0">
    <background>
        <Background>
            <fills>
                <BackgroundFill>
                    <fill>
                        <Color red="0.9725" green="0.9804" blue="0.9882" />
                    </fill>
                </BackgroundFill>
            </fills>
        </Background>
    </background>
    <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="58.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <background>
            <Background>
                <fills>
                    <BackgroundFill>
                        <fill>
                            <Color red="0.0588" green="0.0902" blue="0.1647" />
                        </fill>
                    </BackgroundFill>
                </fills>
            </Background>
        </background>
        <Label text="nodo">
            <font>
                <Font name="Segoe UI Bold" size="18.0" />
            </font>
            <textFill>
                <Color red="1.0" green="1.0" blue="1.0" />
            </textFill>
        </Label>
        <Label text="/  Usuarios">
            <font>
                <Font name="Segoe UI" size="12.0" />
            </font>
            <textFill>
                <Color red="0.7922" green="0.8353" blue="0.9020" />
            </textFill>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Volver al panel" onAction="#onVolver">
            <font>
                <Font name="Segoe UI" size="10.0" />
            </font>
        </Button>
        <Button text="Cerrar sesión" onAction="#onCerrarSesion">
            <font>
                <Font name="Segoe UI" size="10.0" />
            </font>
        </Button>
    </HBox>
    <VBox spacing="2.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <Label text="Usuarios registrados">
            <font>
                <Font name="Segoe UI Bold" size="26.0" />
            </font>
        </Label>
        <Label text="Busca una cuenta y administra su rol desde un solo lugar.">
            <font>
                <Font name="Segoe UI" size="11.0" />
            </font>
            <textFill>
                <Color red="0.3922" green="0.4549" blue="0.5451" />
            </textFill>
        </Label>
    </VBox>
    <VBox spacing="10.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <background>
            <Background>
                <fills>
                    <BackgroundFill>
                        <fill>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </fill>
                    </BackgroundFill>
                </fills>
            </Background>
        </background>
        <effect>
            <DropShadow radius="8.0" offsetY="2.0">
                <color>
                    <Color red="0.0" green="0.0" blue="0.0" opacity="0.08" />
                </color>
            </DropShadow>
        </effect>
        <HBox spacing="8.0">
            <padding>
                <Insets top="14.0" right="16.0" bottom="0.0" left="16.0" />
            </padding>
            <TextField fx:id="busqueda" promptText="Buscar por nombre o correo" HBox.hgrow="ALWAYS">
                <font>
                    <Font name="Segoe UI" size="11.0" />
                </font>
            </TextField>
            <Button text="Buscar" onAction="#onBuscar">
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="0.0588" green="0.0902" blue="0.1647" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <padding>
                    <Insets top="7.0" right="14.0" bottom="7.0" left="14.0" />
                </padding>
                <font>
                    <Font name="Segoe UI Bold" size="10.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Button>
        </HBox>
        <Label fx:id="mensaje" wrapText="true">
            <padding>
                <Insets top="0.0" right="16.0" bottom="0.0" left="16.0" />
            </padding>
            <font>
                <Font name="Segoe UI Bold" size="10.0" />
            </font>
            <textFill>
                <Color red="0.1137" green="0.5216" blue="0.3255" />
            </textFill>
        </Label>
        <TableView fx:id="tabla" prefHeight="320.0" fixedCellSize="36.0">
            <padding>
                <Insets top="0.0" right="16.0" bottom="0.0" left="16.0" />
            </padding>
            <placeholder>
                <Label text="No hay usuarios para mostrar." />
            </placeholder>
            <columns>
                <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="300.0" />
                <TableColumn fx:id="colCorreo" text="CORREO" prefWidth="340.0" />
                <TableColumn fx:id="colRol" text="ROL" prefWidth="180.0" />
            </columns>
        </TableView>
        <HBox spacing="8.0">
            <padding>
                <Insets top="0.0" right="16.0" bottom="16.0" left="16.0" />
            </padding>
            <Button text="Hacer administrador" onAction="#onHacerAdmin"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="0.1137" green="0.5216" blue="0.3255" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <padding>
                    <Insets top="8.0" right="10.0" bottom="8.0" left="10.0" />
                </padding>
                <font>
                    <Font name="Segoe UI Bold" size="10.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Button>
            <Button text="Quitar administrador" onAction="#onQuitarAdmin"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="8.0" right="10.0" bottom="8.0" left="10.0" />
                </padding>
                <font>
                    <Font name="Segoe UI Bold" size="10.0" />
                </font>
            </Button>
            <Button text="Eliminar usuario" onAction="#onEliminar"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="0.9373" green="0.2667" blue="0.2667" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <padding>
                    <Insets top="8.0" right="10.0" bottom="8.0" left="10.0" />
                </padding>
                <font>
                    <Font name="Segoe UI Bold" size="10.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Button>
        </HBox>
    </VBox>
</VBox>
