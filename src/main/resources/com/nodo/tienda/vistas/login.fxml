<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nodo.tienda.controladores.LoginController"
            prefWidth="980.0" prefHeight="700.0">
    <background>
        <Background>
            <fills>
                <BackgroundFill>
                    <fill>
                        <Color red="0.9333" green="0.9412" blue="0.9529" />
                    </fill>
                </BackgroundFill>
            </fills>
        </Background>
    </background>
    <center>
        <StackPane>
            <VBox maxHeight="-Infinity" maxWidth="460.0" prefWidth="460.0" spacing="12.0">
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="1.0" green="1.0" blue="1.0" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <padding>
                    <Insets top="26.0" right="26.0" bottom="26.0" left="26.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="n">
                        <background>
                            <Background>
                                <fills>
                                    <BackgroundFill>
                                        <fill>
                                            <Color red="0.0667" green="0.0941" blue="0.1529" />
                                        </fill>
                                    </BackgroundFill>
                                </fills>
                            </Background>
                        </background>
                        <padding>
                            <Insets top="4.0" right="8.0" bottom="4.0" left="8.0" />
                        </padding>
                        <font>
                            <Font name="Segoe UI Bold" size="15.0" />
                        </font>
                        <textFill>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </textFill>
                    </Label>
                    <Label text="nodo">
                        <font>
                            <Font name="Segoe UI Bold" size="22.0" />
                        </font>
                        <textFill>
                            <Color red="0.0667" green="0.0941" blue="0.1529" />
                        </textFill>
                    </Label>
                </HBox>
                <VBox spacing="4.0">
                    <Label text="Qué bueno verte de nuevo.">
                        <font>
                            <Font name="Segoe UI Bold" size="22.0" />
                        </font>
                        <textFill>
                            <Color red="0.0667" green="0.0941" blue="0.1529" />
                        </textFill>
                    </Label>
                    <Label text="Inicia sesión y encuentra tu próximo favorito." wrapText="true">
                        <textFill>
                            <Color red="0.4196" green="0.4471" blue="0.5020" />
                        </textFill>
                    </Label>
                </VBox>
                <VBox spacing="6.0">
                    <Label text="Usuario o correo electrónico">
                        <font>
                            <Font name="Segoe UI Bold" size="12.0" />
                        </font>
                        <textFill>
                            <Color red="0.2157" green="0.2549" blue="0.3176" />
                        </textFill>
                    </Label>
                    <TextField fx:id="correo" maxWidth="Infinity" prefHeight="36.0"
                               promptText="lucia.martin@email.com" />
                </VBox>
                <VBox spacing="6.0">
                    <Label text="Contraseña">
                        <font>
                            <Font name="Segoe UI Bold" size="12.0" />
                        </font>
                        <textFill>
                            <Color red="0.2157" green="0.2549" blue="0.3176" />
                        </textFill>
                    </Label>
                    <PasswordField fx:id="contrasena" maxWidth="Infinity" prefHeight="36.0"
                                   promptText="••••••••" />
                </VBox>
                <HBox alignment="CENTER_LEFT">
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink onAction="#onOlvidar" text="¿Olvidaste tu contraseña?">
                        <textFill>
                            <Color red="0.9373" green="0.2667" blue="0.2667" />
                        </textFill>
                    </Hyperlink>
                </HBox>
                <Label fx:id="mensaje" managed="false" visible="false" wrapText="true">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                    <textFill>
                        <Color red="0.2157" green="0.2549" blue="0.3176" />
                    </textFill>
                </Label>
                <Button defaultButton="true" maxWidth="Infinity" onAction="#onLogin"
                        prefHeight="40.0" text="→  Iniciar sesión">
                    <background>
                        <Background>
                            <fills>
                                <BackgroundFill>
                                    <fill>
                                        <Color red="0.9373" green="0.2667" blue="0.2667" />
                                    </fill>
                                </BackgroundFill>
                            </fills>
                        </Background>
                    </background>
                    <font>
                        <Font name="Segoe UI Bold" size="12.0" />
                    </font>
                    <textFill>
                        <Color red="1.0" green="1.0" blue="1.0" />
                    </textFill>
                </Button>
                <HBox alignment="CENTER" spacing="2.0">
                    <Label text="¿Aún no tienes cuenta?">
                        <font>
                            <Font name="Segoe UI" size="12.0" />
                        </font>
                        <textFill>
                            <Color red="0.4196" green="0.4471" blue="0.5020" />
                        </textFill>
                    </Label>
                    <Hyperlink onAction="#onRegistrar" text="Regístrate">
                        <font>
                            <Font name="Segoe UI" size="12.0" />
                        </font>
                        <textFill>
                            <Color red="0.9373" green="0.2667" blue="0.2667" />
                        </textFill>
                    </Hyperlink>
                </HBox>
                <Label text="♙   Tu cuenta, siempre protegida.">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                    <textFill>
                        <Color red="0.6118" green="0.6392" blue="0.6863" />
                    </textFill>
                </Label>
            </VBox>
        </StackPane>
    </center>
    <bottom>
        <VBox alignment="CENTER" spacing="2.0">
            <padding>
                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
            </padding>
            <Label text="© 2026 nodo. Tecnología para tu día a día.">
                <font>
                    <Font name="Segoe UI" size="11.0" />
                </font>
                <textFill>
                    <Color red="0.6118" green="0.6392" blue="0.6863" />
                </textFill>
            </Label>
            <HBox alignment="CENTER" spacing="14.0">
                <Hyperlink focusTraversable="false" text="Ayuda">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                    <textFill>
                        <Color red="0.6118" green="0.6392" blue="0.6863" />
                    </textFill>
                </Hyperlink>
                <Hyperlink focusTraversable="false" text="Privacidad">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                    <textFill>
                        <Color red="0.6118" green="0.6392" blue="0.6863" />
                    </textFill>
                </Hyperlink>
                <Hyperlink focusTraversable="false" text="Términos y condiciones">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                    <textFill>
                        <Color red="0.6118" green="0.6392" blue="0.6863" />
                    </textFill>
                </Hyperlink>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
