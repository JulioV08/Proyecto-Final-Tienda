<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nodo.tienda.controladores.CuentaControlador"
      prefWidth="980.0" prefHeight="700.0" spacing="14.0">
    <background>
        <Background>
            <fills>
                <BackgroundFill>
                    <fill>
                        <Color red="0.9725" green="0.9804" blue="0.9882" />
                    </fill>
                </BackgroundFill>
            </fills>
        </Background>
    </background>
    <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="58.0">
        <background>
            <Background>
                <fills>
                    <BackgroundFill>
                        <fill>
                            <Color red="0.0588" green="0.0902" blue="0.1647" />
                        </fill>
                    </BackgroundFill>
                </fills>
            </Background>
        </background>
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <Label text="nodo">
            <font>
                <Font name="Segoe UI Bold" size="18.0" />
            </font>
            <textFill>
                <Color red="1.0" green="1.0" blue="1.0" />
            </textFill>
        </Label>
        <Label text="/  Cuenta">
            <font>
                <Font name="Segoe UI" size="12.0" />
            </font>
            <textFill>
                <Color red="0.7922" green="0.8353" blue="0.9020" />
            </textFill>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Volver al panel" onAction="#onVolver">
            <font>
                <Font name="Segoe UI" size="10.0" />
            </font>
        </Button>
        <Button text="Cerrar sesión" onAction="#onCerrarSesion">
            <font>
                <Font name="Segoe UI" size="10.0" />
            </font>
        </Button>
    </HBox>
    <VBox spacing="2.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <Label text="Mi cuenta">
            <font>
                <Font name="Segoe UI Bold" size="26.0" />
            </font>
        </Label>
        <Label text="Tus datos, tu rol y la actividad de tu cuenta nodo.">
            <font>
                <Font name="Segoe UI" size="11.0" />
            </font>
            <textFill>
                <Color red="0.3922" green="0.4549" blue="0.5451" />
            </textFill>
        </Label>
    </VBox>
    <HBox spacing="14.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <VBox alignment="CENTER" spacing="8.0" prefWidth="250.0">
            <padding>
                <Insets top="24.0" right="18.0" bottom="24.0" left="18.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.0588" green="0.0902" blue="0.1647" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <effect>
                <DropShadow radius="8.0" offsetY="2.0">
                    <color>
                        <Color red="0.0" green="0.0" blue="0.0" opacity="0.10" />
                    </color>
                </DropShadow>
            </effect>
            <VBox alignment="CENTER" spacing="0.0" prefWidth="76.0" prefHeight="76.0">
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="0.9373" green="0.2667" blue="0.2667" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <Label text="nodo">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                    </font>
                    <textFill>
                        <Color red="1.0" green="1.0" blue="1.0" />
                    </textFill>
                </Label>
            </VBox>
            <Label text="ADMINISTRADOR">
                <font>
                    <Font name="Segoe UI Bold" size="10.0" />
                </font>
                <textFill>
                    <Color red="0.9373" green="0.2667" blue="0.2667" />
                </textFill>
            </Label>
            <Label fx:id="nombre" text="Nombre: Admin Nodo" wrapText="true" alignment="CENTER">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
            <Label text="Cuenta protegida del sistema" wrapText="true" alignment="CENTER">
                <font>
                    <Font name="Segoe UI" size="10.0" />
                </font>
                <textFill>
                    <Color red="0.7922" green="0.8353" blue="0.9020" />
                </textFill>
            </Label>
        </VBox>
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="16.0" right="18.0" bottom="16.0" left="18.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="1.0" green="1.0" blue="1.0" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <effect>
                <DropShadow radius="8.0" offsetY="2.0">
                    <color>
                        <Color red="0.0" green="0.0" blue="0.0" opacity="0.08" />
                    </color>
                </DropShadow>
            </effect>
            <Label text="Datos personales">
                <font>
                    <Font name="Segoe UI Bold" size="14.0" />
                </font>
            </Label>
            <VBox spacing="4.0">
                <padding>
                    <Insets top="10.0" right="12.0" bottom="10.0" left="12.0" />
                </padding>
                <background>
                    <Background>
                        <fills>
                            <BackgroundFill>
                                <fill>
                                    <Color red="0.9725" green="0.9804" blue="0.9882" />
                                </fill>
                            </BackgroundFill>
                        </fills>
                    </Background>
                </background>
                <Label fx:id="correo" text="Correo: admin@nodo.com">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                </Label>
                <Label fx:id="telefono" text="Teléfono: 300 000 0000">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                </Label>
                <Label fx:id="rol" text="Rol: Administrador">
                    <font>
                        <Font name="Segoe UI" size="11.0" />
                    </font>
                </Label>
            </VBox>
            <HBox spacing="8.0">
                <Button text="Editar datos" onAction="#onEditar"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                    <background>
                        <Background>
                            <fills>
                                <BackgroundFill>
                                    <fill>
                                        <Color red="0.9373" green="0.2667" blue="0.2667" />
                                    </fill>
                                </BackgroundFill>
                            </fills>
                        </Background>
                    </background>
                    <padding>
                        <Insets top="9.0" right="12.0" bottom="9.0" left="12.0" />
                    </padding>
                    <font>
                        <Font name="Segoe UI Bold" size="10.0" />
                    </font>
                    <textFill>
                        <Color red="1.0" green="1.0" blue="1.0" />
                    </textFill>
                </Button>
                <Button text="Volver al panel" onAction="#onVolver"
                        maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="9.0" right="12.0" bottom="9.0" left="12.0" />
                    </padding>
                    <font>
                        <Font name="Segoe UI Bold" size="10.0" />
                    </font>
                </Button>
            </HBox>
            <Label text="Esta es tu cuenta principal. No puede ser eliminada ni modificada desde Usuarios."
                   wrapText="true">
                <font>
                    <Font name="Segoe UI" size="9.0" />
                </font>
                <textFill>
                    <Color red="0.3922" green="0.4549" blue="0.5451" />
                </textFill>
            </Label>
        </VBox>
    </HBox>
</VBox>
