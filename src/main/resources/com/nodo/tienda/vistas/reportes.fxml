<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nodo.tienda.controladores.ReportesControlador"
      prefWidth="980.0" prefHeight="700.0" spacing="12.0">
    <padding>
        <Insets top="0.0" right="0.0" bottom="22.0" left="0.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="58.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <background>
            <Background>
                <fills>
                    <BackgroundFill>
                        <fill>
                            <Color red="0.0588" green="0.0902" blue="0.1647" />
                        </fill>
                    </BackgroundFill>
                </fills>
            </Background>
        </background>
        <Label text="nodo">
            <font>
                <Font name="Segoe UI Bold" size="18.0" />
            </font>
            <textFill>
                <Color red="1.0" green="1.0" blue="1.0" />
            </textFill>
        </Label>
        <Label text="/  Reportes">
            <font>
                <Font name="Segoe UI" size="12.0" />
            </font>
            <textFill>
                <Color red="0.7922" green="0.8353" blue="0.9020" />
            </textFill>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Volver al panel" onAction="#onVolver" />
        <Button text="Cerrar sesión" onAction="#onCerrarSesion" />
    </HBox>
    <VBox spacing="2.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <Label text="Reportes del sistema">
            <font>
                <Font name="Segoe UI Bold" size="26.0" />
            </font>
        </Label>
        <Label text="Vista general del inventario, las ventas y los usuarios.">
            <font>
                <Font name="Segoe UI" size="11.0" />
            </font>
            <textFill>
                <Color red="0.3922" green="0.4549" blue="0.5451" />
            </textFill>
        </Label>
    </VBox>
    <HBox spacing="10.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="10.0" right="6.0" bottom="10.0" left="6.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.0588" green="0.0902" blue="0.1647" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label fx:id="productos" text="0">
                <font>
                    <Font name="Segoe UI Bold" size="22.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
            <Label text="PRODUCTOS">
                <font>
                    <Font name="Segoe UI Bold" size="8.0" />
                </font>
                <textFill>
                    <Color red="0.7922" green="0.8353" blue="0.9020" />
                </textFill>
            </Label>
        </VBox>
        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="10.0" right="6.0" bottom="10.0" left="6.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.1137" green="0.5216" blue="0.3255" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label fx:id="unidades" text="0">
                <font>
                    <Font name="Segoe UI Bold" size="22.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
            <Label text="UNIDADES">
                <font>
                    <Font name="Segoe UI Bold" size="8.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
        </VBox>
        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="10.0" right="6.0" bottom="10.0" left="6.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.9373" green="0.2667" blue="0.2667" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label fx:id="valor" text="0">
                <font>
                    <Font name="Segoe UI Bold" size="18.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
            <Label text="VALOR INVENTARIO">
                <font>
                    <Font name="Segoe UI Bold" size="8.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
        </VBox>
        <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="10.0" right="6.0" bottom="10.0" left="6.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.2549" green="0.4118" blue="0.8824" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label fx:id="pedidos" text="0">
                <font>
                    <Font name="Segoe UI Bold" size="18.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
            <Label text="VENTAS">
                <font>
                    <Font name="Segoe UI Bold" size="8.0" />
                </font>
                <textFill>
                    <Color red="1.0" green="1.0" blue="1.0" />
                </textFill>
            </Label>
        </VBox>
    </HBox>
    <HBox spacing="10.0">
        <padding>
            <Insets top="0.0" right="36.0" bottom="0.0" left="36.0" />
        </padding>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="1.0" green="1.0" blue="1.0" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label text="Unidades por categoría">
                <font>
                    <Font name="Segoe UI Bold" size="14.0" />
                </font>
            </Label>
            <BarChart fx:id="graficaCategorias" title="Inventario por categoría"
                      legendVisible="false" animated="false" VBox.vgrow="ALWAYS"
                      prefHeight="340.0">
                <xAxis>
                    <CategoryAxis label="Categoría" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Unidades" autoRanging="true" forceZeroInRange="true" />
                </yAxis>
            </BarChart>
        </VBox>
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0" />
            </padding>
            <background>
                <Background>
                    <fills>
                        <BackgroundFill>
                            <fill>
                                <Color red="0.9333" green="0.9412" blue="0.9529" />
                            </fill>
                        </BackgroundFill>
                    </fills>
                </Background>
            </background>
            <Label text="Estado del inventario">
                <font>
                    <Font name="Segoe UI Bold" size="14.0" />
                </font>
            </Label>
            <Label fx:id="usuarios" text="Usuarios: 0" />
            <Label fx:id="umbral" text="Tope máximo: 80" />
            <Label fx:id="detalleStock" wrapText="true" text="Disponibles: 0" />
            <Label text="Salud del inventario">
                <font>
                    <Font name="Segoe UI Bold" size="11.0" />
                </font>
            </Label>
            <ProgressBar fx:id="barSalud" progress="0.0" prefWidth="380.0" />
        </VBox>
    </HBox>
</VBox>
