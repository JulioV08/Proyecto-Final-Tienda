<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nodo.tienda.controladores.NuevoProductoControlador"
      prefWidth="980.0" prefHeight="700.0" spacing="12.0">
    <padding>
        <Insets top="22.0" right="36.0" bottom="22.0" left="36.0" />
    </padding>
    <background>
        <Background>
            <fills>
                <BackgroundFill>
                    <fill>
                        <Color red="0.9333" green="0.9412" blue="0.9529" />
                    </fill>
                </BackgroundFill>
            </fills>
        </Background>
    </background>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="nodo">
            <font>
                <Font name="Segoe UI Bold" size="20.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="usuario" text="Administrador" />
        <Button text="Volver al panel" onAction="#onVolver" />
        <Button text="Cerrar sesión" onAction="#onCerrarSesion" />
    </HBox>
    <Label text="Registrar producto nuevo">
        <font>
            <Font name="Segoe UI Bold" size="26.0" />
        </font>
    </Label>
    <Label text="Completa los datos y elige una imagen para el producto.">
        <font>
            <Font name="Segoe UI" size="12.0" />
        </font>
    </Label>
    <HBox spacing="22.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <TextField fx:id="nombre" promptText="Nombre del producto" />
            <ComboBox fx:id="categoria" prefWidth="380.0" promptText="Categoría" />
            <HBox spacing="8.0">
                <TextField fx:id="precio" promptText="Precio" HBox.hgrow="ALWAYS" />
                <TextField fx:id="stock" promptText="Stock" HBox.hgrow="ALWAYS" />
            </HBox>
            <TextField fx:id="icono" promptText="Ícono (opcional)" />
            <TextArea fx:id="descripcion" promptText="Descripción" prefRowCount="4" wrapText="true" />
            <CheckBox fx:id="destacado" text="Producto destacado" />
            <HBox spacing="8.0">
                <Button text="Registrar producto" onAction="#onRegistrar">
                    <font>
                        <Font name="Segoe UI Bold" size="11.0" />
                    </font>
                </Button>
                <Button text="Limpiar" onAction="#onLimpiar" />
            </HBox>
        </VBox>
        <VBox alignment="TOP_CENTER" spacing="8.0" prefWidth="220.0">
            <ImageView fx:id="vistaImagen" fitWidth="190.0" fitHeight="190.0"
                       preserveRatio="true" smooth="true" />
            <Button text="Elegir imagen" onAction="#onElegirImagen" />
            <Label fx:id="rutaImagen" text="Sin imagen seleccionada" wrapText="true" />
        </VBox>
    </HBox>
    <Label fx:id="mensaje" wrapText="true" />
</VBox>
